# Web app config (public values, safe in the client bundle). Copy to .env.local.
# Values come from the Firebase console for joinery-staging or joinery-prod.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-joinery
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# "true" connects the app to the local Emulator Suite instead of a real project.
VITE_USE_EMULATORS=true
