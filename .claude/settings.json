{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm --dir functions install)",
      "Bash(pnpm --dir functions install --frozen-lockfile)",
      "Bash(pnpm run dev)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run lint:fix)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run build)",
      "Bash(pnpm run size)",
      "Bash(pnpm run build:functions)",
      "Bash(pnpm run emulators)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(firebase deploy:*)",
      "Bash(pnpm exec firebase deploy:*)",
      "Bash(firebase projects:create:*)",
      "Bash(pnpm exec firebase projects:create:*)",
      "Bash(firebase use:*)",
      "Bash(pnpm exec firebase use:*)",
      "Bash(firebase login:*)",
      "Bash(pnpm exec firebase login:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/service-account*.json)",
      "mcp__firebase__firebase_deploy",
      "mcp__firebase__firebase_create_project",
      "mcp__firebase__firebase_create_app",
      "mcp__firebase__firebase_create_android_sha",
      "mcp__firebase__firebase_login",
      "mcp__firebase__firebase_logout",
      "mcp__firebase__firebase_update_environment",
      "mcp__firebase__firebase_init",
      "mcp__firebase__firestore_add_document",
      "mcp__firebase__firestore_update_document",
      "mcp__firebase__firestore_delete_document",
      "mcp__firebase__firestore_get_document",
      "mcp__firebase__firestore_list_documents",
      "mcp__firebase__firestore_query_collection",
      "mcp__firebase__firestore_create_database",
      "mcp__firebase__firestore_update_database",
      "mcp__firebase__firestore_delete_database",
      "mcp__firebase__firestore_create_index",
      "mcp__firebase__firestore_delete_index",
      "mcp__firebase__firestore_create_backup_schedule",
      "mcp__firebase__firestore_update_backup_schedule",
      "mcp__firebase__firestore_delete_backup_schedule",
      "mcp__firebase__firestore_delete_backup",
      "mcp__firebase__auth_get_users",
      "mcp__firebase__auth_update_user",
      "mcp__firebase__auth_set_sms_region_policy",
      "mcp__firebase__messaging_send_message",
      "mcp__firebase__realtimedatabase_get_data",
      "mcp__firebase__realtimedatabase_set_data",
      "mcp__firebase__remoteconfig_update_template",
      "mcp__firebase__storage_get_object_download_url",
      "mcp__firebase__functions_get_logs",
      "mcp__firebase__apphosting_fetch_logs",
      "mcp__firebase__dataconnect_execute_graphql",
      "mcp__firebase__dataconnect_execute_graphql_read"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
