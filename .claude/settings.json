{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm --dir functions install)",
      "Bash(pnpm --dir functions install --frozen-lockfile)",
      "Bash(pnpm run dev)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run lint:fix)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run build)",
      "Bash(pnpm run size)",
      "Bash(pnpm run build:functions)",
      "Bash(pnpm run emulators)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(firebase deploy:*)",
      "Bash(pnpm exec firebase deploy:*)",
      "Bash(firebase projects:create:*)",
      "Bash(pnpm exec firebase projects:create:*)",
      "Bash(firebase use:*)",
      "Bash(pnpm exec firebase use:*)",
      "Bash(firebase login:*)",
      "Bash(pnpm exec firebase login:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/service-account*.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
